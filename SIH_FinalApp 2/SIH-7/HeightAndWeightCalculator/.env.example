# Copy this file to .env and fill in your own values. Never commit .env.
# AI Coach chatbot - Meta Model API (Muse Spark). Takes priority over Gemini.
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
META_REASONING_EFFORT=low
# Old provider, only used if MODEL_API_KEY is empty
GEMINI_API_KEY=
MONGODB_URI=mongodb://localhost:27017/
SECRET_KEY=change-me-to-a-long-random-string

# --- Face identity check ---
# 1 = an exercise can only start after a successful face match (recommended)
DEEPFIT_REQUIRE_FACE=1
# SFace cosine similarity needed to accept a match (0.363 is the model default)
DEEPFIT_FACE_THRESHOLD=0.40
# How long a successful face check stays valid before starting (seconds)
DEEPFIT_VERIFY_TTL=300

# --- Performance ---
DEEPFIT_THREADS=2
DEEPFIT_STREAM_FPS=15
DEEPFIT_JPEG_QUALITY=70
DEEPFIT_POSE_COMPLEXITY=1
# MiDaS depth model; its output is currently unused, keep off
DEEPFIT_ENABLE_DEPTH=0
FLASK_DEBUG=0
# Fallback AI provider (used automatically when the Meta account has no credits or is unreachable):
# Groq - Meta's Muse Spark open weights, then Llama 3.3 70B; Whisper for voice. Get a key at console.groq.com
GROQ_API_KEY=
# GROQ_CHAT_MODELS=meta-models/muse-spark-open,llama-3.3-70b-versatile
# GROQ_VISION_MODELS=meta-models/muse-spark-open,qwen/qwen3.8-27b
