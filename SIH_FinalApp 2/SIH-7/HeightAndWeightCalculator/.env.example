# Copy this file to .env and fill in your own values. Never commit .env.
# AI Coach chatbot - Meta Model API (Muse Spark), tried first.
MODEL_API_KEY=
# Which AI providers may answer (default: meta only). Add the fallbacks with: AI_PROVIDERS=meta,groq,gemini
# AI_PROVIDERS=meta
META_MODEL=muse-spark-1.3
META_REASONING_EFFORT=low
MONGODB_URI=mongodb://localhost:27017/
SECRET_KEY=change-me-to-a-long-random-string

# --- Face identity check ---
# 1 = an exercise can only start after a successful face match (recommended)
DEEPFIT_REQUIRE_FACE=1
# SFace cosine similarity needed to accept a match (0.363 is the model default)
DEEPFIT_FACE_THRESHOLD=0.40
# How long a successful face check stays valid before starting (seconds)
DEEPFIT_VERIFY_TTL=300

# --- Performance ---
DEEPFIT_THREADS=2
DEEPFIT_STREAM_FPS=15
DEEPFIT_JPEG_QUALITY=70
DEEPFIT_POSE_COMPLEXITY=1
# MiDaS depth model; its output is currently unused, keep off
DEEPFIT_ENABLE_DEPTH=0
FLASK_DEBUG=0
# Fallback AI provider (used automatically when the Meta account has no credits or is unreachable):
# Groq - Meta's Muse Spark open weights, then Llama 3.3 70B; Whisper for voice. Get a key at console.groq.com
GROQ_API_KEY=
# GROQ_CHAT_MODELS=meta-models/muse-spark-open,llama-3.3-70b-versatile
# GROQ_VISION_MODELS=meta-models/muse-spark-open,qwen/qwen3.8-27b
# Last fallback: Google Gemini (free key at aistudio.google.com/apikey). Shown as "DeepFit AI" in the interface.
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-3.8-flash,gemini-2.5-flash

# --- Talent Passport and QR codes ---
# Signs every result. Use the SAME value on the laptop and on Render, or a result made on one shows NOT VALID on the other.
# PASSPORT_SECRET=
# Where QR codes point. Set it to your Render address (https://....onrender.com) so a QR scanned by any phone opens -
# that works only if the laptop and Render use the same MongoDB (MONGODB_URI) and the same PASSPORT_SECRET.
# PUBLIC_BASE_URL=
